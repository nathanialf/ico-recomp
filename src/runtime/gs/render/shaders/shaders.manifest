# src/runtime/gs/render/shaders/shaders.manifest: the shader list,
# generated by tools/gen_gs_shaders.sh. Do not edit by hand.
#
# tools/gen_gs_shaders_dxil.sh and tools/gen_gs_shaders_dxil.ps1 read it so
# the DXIL stage compiles exactly the shaders this script emitted, in the
# same order.
# One 'name stage' pair per line; the shader model follows from the
# stage.
scanout comp
raster comp
shadow comp
overlay vert
overlay frag
