/* ui/style/base.rcss: the shared look of the overlay documents.
 *
 * Deliberately restricted to what the overlay renderer can draw
 * (src/runtime/ui/ui_render.cpp): solid and translucent boxes, text, and
 * scissored regions. No border-radius, box-shadow, gradients, filters,
 * container opacity or clip masks: each of those reaches a RenderInterface
 * function that is not implemented in this build and logs a line saying so.
 * The one transform in the document is the rotated bracket label.
 *
 * Sizes are in dp, not px. The context's density-independent pixel ratio is
 * set from the surface height against the 640x480 baseline (ui.cpp), so the
 * same document reads at the same size in a small window and a large one.
 * 640x480 is the layout's design size, not the default window size: the
 * default window is 1280x960, the same layout at a dp ratio of exactly 2.
 * Every width below is derived to fit at ratio 1, so the whole layout is
 * still readable in a window dragged down to the baseline.
 *
 * RmlUi ships no default stylesheet, so every element used by a document
 * gets its display value here.
 *
 * Two families, one rule: JetBrains Mono carries everything a value is read
 * out of (labels, controls, values, hints, taglines, the footer, the fps
 * readout), Playfair Display carries names and titles (nav names, section
 * titles, the launcher title, the credits byline). Both are loaded in
 * ui.cpp, which disables the UI if either is missing.
 *
 * Column widths are derived from the longest string each column can hold,
 * at the mono advance of 0.6em plus that rule's letter-spacing. The three
 * that decide a width are "Right stick right" (binding slot), "Trigger
 * threshold" (control label) and "Fullscreen (exclusive)" (select value).
 *
 * Overflow: anything whose text is not bounded by this file (a settings
 * path, a disc path, a binding name, a version string) either wraps or is
 * clipped with an ellipsis. RmlUi resolves text-overflow against the
 * element holding the text, and only when that element's overflow is not
 * visible (Source/Core/ElementText.cpp ResolveTextOverflow), so the three
 * always appear together: white-space: nowrap, overflow: hidden,
 * text-overflow: ellipsis. All three are registered properties in RmlUi 6.3
 * (Source/Core/StyleSheetSpecification.cpp), and the ellipsis glyph U+2026
 * is present in both fonts.
 *
 * Palette, one place:
 *   panels    #0a0a0a  #0d0d0d  #171717
 *   hairlines #1a1a1a  #262626  #525252
 *   type      #333333  #404040  #525252  #737373  #a3a3a3  #d4d4d4
 *             #e5e5e5  #f9fafb
 *   accent    #bfff00 (a control that is on)
 *   warning   #d4a000 on #2d2000, border #4d3800
 */

/* ---- elements ----------------------------------------------------------- */

body {
	font-family: "JetBrains Mono";
	font-weight: 400;
	font-style: normal;
	font-size: 11dp;
	color: #d4d4d4;
}

div {
	display: block;
}

span {
	display: inline;
}

/* ---- menu shell --------------------------------------------------------- */

body.menu {
	width: 100%;
	height: 100%;
	box-sizing: border-box;
	padding: 12dp 14dp;
	display: flex;
	flex-direction: column;
	/* The one translucent surface: the game's scanout stays visible behind
	 * the panel. The alpha is on the background color, not on the element;
	 * container opacity would need a render layer. */
	background-color: rgba(10, 10, 10, 217);
}

.shell {
	display: flex;
	flex-direction: row;
	flex-grow: 1;
	min-height: 0;
}

/* ---- left navigation column ---------------------------------------------
 *
 * 160dp of the 612dp the body's padding leaves at the baseline: 140dp of
 * buttons, then the 14dp bracket and its 6dp gap. A button's text box is
 * 140dp less 9dp of padding either side and 1dp of border, so 120dp, which
 * is 24 characters of the 8dp tagline (8 * (0.6 + 0.02) = 4.96dp each).
 * The longest tagline in the document is 22. A longer one wraps to a
 * second line and the button grows, which is why nothing here is nowrap. */

.nav {
	display: flex;
	flex-direction: row;
	width: 160dp;
	flex-shrink: 0;
}

.nav-stack {
	display: block;
	flex-grow: 1;
	min-width: 0;
}

.nav-button {
	display: flex;
	flex-direction: column;
	width: 100%;
	box-sizing: border-box;
	padding: 7dp 9dp;
	margin-bottom: 5dp;
	background-color: transparent;
	border: 1dp #262626;
	tab-index: auto;
	nav: auto;
}

.nav-button:hover,
.nav-button:focus,
.nav-button.active {
	background-color: #525252;
	border-color: #525252;
}

.nav-name {
	display: block;
	font-family: "Playfair Display";
	font-weight: 700;
	font-size: 12dp;
	letter-spacing: 0.05em;
	color: #f9fafb;
	line-height: 1.2;
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
}

.nav-tagline {
	display: block;
	font-size: 8dp;
	letter-spacing: 0.02em;
	color: #737373;
	line-height: 1.3;
	margin-top: 2dp;
}

.nav-button:hover .nav-name,
.nav-button:focus .nav-name,
.nav-button.active .nav-name {
	color: #ffffff;
}

.nav-button:hover .nav-tagline,
.nav-button:focus .nav-tagline,
.nav-button.active .nav-tagline {
	color: rgba(255, 255, 255, 204);
}

/* The bracket beside the nav stack: a 1dp vertical line with 1dp caps
 * reaching back toward the buttons, and a label rotated onto the line.
 * Built from nested divs because RCSS has no ::before/::after. */
.bracket {
	display: flex;
	flex-direction: column;
	width: 14dp;
	flex-shrink: 0;
	margin-left: 6dp;
	margin-bottom: 5dp;
}

.bracket-cap {
	display: block;
	width: 5dp;
	height: 1dp;
	margin-left: -5dp;
	background-color: #525252;
}

.bracket-line {
	display: flex;
	flex-direction: row;
	align-items: center;
	width: 1dp;
	flex-grow: 1;
	background-color: #525252;
}

/* Rotated about its own center, so the pre-rotation box is centered on the
 * line with a negative margin of half its width. 70dp holds "Settings" at
 * 8dp mono with 0.1em of letter-spacing (8 * 0.7 = 5.6dp each, 45dp in
 * all) with room to spare; after rotation the box is 14dp across, which is
 * the bracket's width. Nowrap because a wrap here would rotate a second
 * line into the nav column. */
.bracket-label {
	display: block;
	width: 70dp;
	margin-left: -35dp;
	padding: 2dp 0;
	background-color: #0a0a0a;
	text-align: center;
	text-transform: uppercase;
	letter-spacing: 0.1em;
	font-size: 8dp;
	color: #525252;
	white-space: nowrap;
	transform: rotate(-90deg);
}

/* ---- content pane -------------------------------------------------------
 *
 * Scrolls vertically and clips horizontally: every row inside it either
 * wraps or ellipsizes, so nothing needs horizontal room, and clipping is
 * the backstop rather than the mechanism. An open dropdown is not clipped
 * by this: RmlUi gives the select box clip: none (WidgetDropDown.cpp), so
 * it escapes the pane's clip region. At the baseline the pane's content is
 * 434dp wide, less the 5dp scrollbar. */

.pane {
	display: block;
	flex-grow: 1;
	min-width: 0;
	overflow-x: hidden;
	overflow-y: auto;
	padding-left: 14dp;
	padding-right: 4dp;
}

scrollbarvertical {
	width: 5dp;
}

scrollbarvertical slidertrack {
	background-color: #1a1a1a;
}

scrollbarvertical sliderbar {
	width: 5dp;
	min-height: 24dp;
	background-color: #404040;
}

scrollbarvertical sliderbar:hover {
	background-color: #525252;
}

.section {
	display: block;
	margin-bottom: 14dp;
}

.section-header {
	display: flex;
	flex-direction: row;
	align-items: baseline;
	border-bottom: 1dp #262626;
	padding-bottom: 3dp;
	margin-bottom: 8dp;
}

.section-number {
	display: block;
	font-size: 8dp;
	color: #404040;
	flex-shrink: 0;
	margin-right: 8dp;
}

.section-title {
	display: block;
	font-family: "Playfair Display";
	font-size: 12dp;
	font-weight: 700;
	text-transform: uppercase;
	letter-spacing: 0.06em;
	color: #d4d4d4;
	min-width: 0;
	overflow: hidden;
	text-overflow: ellipsis;
}

.note {
	display: block;
	font-size: 9dp;
	color: #525252;
	line-height: 1.5;
}

/* ---- controls -----------------------------------------------------------
 *
 * A label is 9dp mono with 0.05em of letter-spacing, so 5.85dp a character:
 * "Trigger threshold", the longest, is 100dp of the 429dp the pane leaves.
 * Labels therefore never need to wrap, and are not told to. */

.control {
	display: block;
	margin-bottom: 10dp;
}

.control-label {
	display: block;
	font-size: 9dp;
	text-transform: uppercase;
	letter-spacing: 0.05em;
	color: #737373;
	margin-bottom: 3dp;
}

.hint {
	display: block;
	font-size: 9dp;
	color: #525252;
	line-height: 1.4;
	margin-top: 3dp;
}

/* An environment variable owns this key for the life of the run. */
.override {
	display: block;
	font-size: 9dp;
	line-height: 1.4;
	color: #d4a000;
	background-color: #2d2000;
	border: 1dp #4d3800;
	padding: 4dp 5dp;
	margin-top: 4dp;
}

input,
select {
	tab-index: auto;
	nav: auto;
}

/* Every text field and select gets a width in dp rather than a percentage
 * of the pane: stretched to the pane a select puts its arrow at the far
 * right of a very wide bar, which reads as a table row rather than as a
 * control. 220dp is the width of the longest option string it has to hold,
 * "Fullscreen (exclusive)": 22 characters of 10dp mono (6dp each, 132dp)
 * plus 14dp of border and padding on both sides and the 24dp kept clear on
 * the right for the arrow, so 170dp, with room left for a longer one.
 * "3840 x 2880 (6x)", the widest window size, is 96dp of text. The label
 * stays on its own line above.
 *
 * The vertical padding is 3dp and not 4dp: 20dp of border box less 2dp of
 * border leaves 18dp, and one 10dp line at the inherited line-height of
 * 1.2 is 12dp, so 3dp above and below centres that line on the control.
 * With 4dp the content box was 10dp, two short of the line it holds, and
 * the text sat 1dp low in a text field and 5dp low in a select (see the
 * selectvalue rule below). */
input.text,
select {
	display: block;
	box-sizing: border-box;
	width: 220dp;
	max-width: 100%;
	height: 20dp;
	padding: 3dp 6dp;
	font-size: 10dp;
	background-color: #171717;
	border: 1dp #262626;
	color: #e5e5e5;
	text-align: left;
}

input.text:focus,
select:focus {
	border-color: #404040;
}

input.text:disabled,
select:disabled,
input.checkbox:disabled,
input.range:disabled {
	color: #525252;
	border-color: #1a1a1a;
}

/* WidgetDropDown builds the select's three children and places two of them
 * itself, both against the select's content box and not its border box:
 * the value element is offset to the content origin (WidgetDropDown.cpp
 * OnRender, SetOffset right after FormatElement) and the arrow is anchored
 * TOP_RIGHT within the content box (ElementUtilities::PositionElement).
 * The select's own padding therefore already moved both of them; whatever
 * they set for themselves is measured from a 206x12dp content area at
 * (7,4) inside the 220x20dp border box. Repeating the select's 20dp height
 * and 4dp 6dp padding here is what pushed the value text to a centre of
 * 15dp in a control whose centre is 10dp, and hung the last 5dp of the box
 * below the bottom border.
 *
 * The widget sets overflow: hidden on this element itself, which is what
 * lets text-overflow resolve here. */
select selectvalue {
	width: auto;
	/* FormatElement is handed the select's border box, so width: auto
	 * resolves against 220dp: 24dp of margin leaves 196dp, ending the text
	 * at x=203dp where the arrow begins rather than under it. */
	margin-right: 24dp;
	/* Exactly the 12dp line box, with no padding of its own: the select's
	 * padding has already placed this box at (7,4), so the line runs from
	 * 4dp to 16dp and its centre is the control's centre. */
	height: 12dp;
	padding: 0dp;
	color: #e5e5e5;
	white-space: nowrap;
	text-overflow: ellipsis;
}

/* A downward triangle drawn out of borders on a zero-sized box. The
 * overlay renderer has no file images, no gradients and no shaders
 * (docs/SETTINGS.md, supported RCSS subset), so an image or gradient
 * decorator would draw nothing at all; borders are plain triangles and are
 * drawn. RmlUi mitres border corners, and with a 0x0 padding box the two
 * inner corners of the top edge collapse onto the same point
 * (GeometryBackgroundBorder::ComputeBorderMetrics), which leaves the top
 * border as a 10dp wide, 6dp tall triangle pointing down. The side borders
 * are transparent, so they are skipped rather than blended.
 *
 * The arrow is anchored to the top right of the content box, so its right
 * edge lands at 213dp, the same 7dp in from the border box as the text is
 * on the left. margin-top centres it: 4dp of content origin plus 3dp puts
 * the 6dp triangle at 7dp to 13dp, centred on the control's 10dp. */
select selectarrow {
	width: 0dp;
	height: 0dp;
	margin-top: 3dp;
	border-top: 6dp #a3a3a3;
	border-left: 5dp transparent;
	border-right: 5dp transparent;
}

select:hover selectarrow {
	border-top-color: #e5e5e5;
}

select:disabled selectarrow {
	border-top-color: #404040;
}

/* box-sizing keeps the open list exactly as wide as the control: the
 * widget formats this element against the select's border box and offsets
 * it to the border box origin, so a content-box 100% would be 222dp under
 * a 220dp control. */
select selectbox {
	margin-left: 0;
	box-sizing: border-box;
	width: 100%;
	max-height: 120dp;
	background-color: #171717;
	border: 1dp #262626;
}

/* display: block is also what the widget sets on each option as it adopts
 * it; stating it here means an option laid out before that still reads as
 * a row rather than as inline text. 3dp above and below the 12dp line box
 * makes an 18dp row with the text centred in it, and the 6dp inset behind
 * the list's own 1dp border puts a row's text at the same 7dp from the
 * left edge as the closed value above it. */
select selectbox option {
	display: block;
	width: auto;
	padding: 3dp 6dp;
	font-size: 10dp;
	color: #a3a3a3;
	background-color: #171717;
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
}

select selectbox option:checked {
	color: #e5e5e5;
}

select selectbox option:hover {
	background-color: #262626;
	color: #f9fafb;
}

.check-row {
	display: flex;
	flex-direction: row;
	align-items: center;
}

input.checkbox {
	display: inline-block;
	width: 11dp;
	height: 11dp;
	flex-shrink: 0;
	margin-right: 7dp;
	background-color: #171717;
	border: 1dp #262626;
}

input.checkbox:hover {
	border-color: #404040;
}

input.checkbox:checked {
	background-color: #bfff00;
	border-color: #bfff00;
}

/* Wraps rather than ellipsizes: the checkbox beside it is the control, and
 * a clipped label would hide which setting it is. */
.check-label {
	display: block;
	min-width: 0;
	font-size: 10dp;
	line-height: 1.3;
	color: #d4d4d4;
}

/* The same 220dp box as a select, so the controls line up down the pane:
 * the slider takes what the reading beside it leaves. */
.range-row {
	display: flex;
	flex-direction: row;
	align-items: center;
	width: 220dp;
	max-width: 100%;
}

input.range {
	display: block;
	flex-grow: 1;
	min-width: 0;
	height: 14dp;
}

input.range slidertrack {
	height: 4dp;
	margin-top: 5dp;
	background-color: #262626;
}

input.range sliderbar {
	width: 14dp;
	height: 14dp;
	background-color: #525252;
}

input.range sliderbar:hover,
input.range sliderbar:active {
	background-color: #737373;
}

/* Widest reading is "100" for the volume and "0.95" for a deadzone: four
 * characters of 10dp mono, 24dp. */
.range-value {
	display: block;
	width: 36dp;
	flex-shrink: 0;
	margin-left: 8dp;
	text-align: right;
	font-size: 10dp;
	color: #a3a3a3;
	white-space: nowrap;
	overflow: hidden;
}

/* ---- binding tables ------------------------------------------------------
 *
 * One row per RtKeyBind / RtPadBind slot, rendered by a data-for loop in
 * menu.rml. Same construction as the controls above: hairline separators and
 * flat boxes only, nothing that reaches an unimplemented RenderInterface
 * call.
 *
 * The row is three columns: a fixed slot name, the binding, and the button.
 * The slot column is 104dp, which is "Right stick right" at 9dp mono with
 * 0.05em of letter-spacing (17 characters at 5.85dp). The button is sized
 * by its own text and never shrinks. The binding takes what is left, 264dp
 * at the baseline, and ellipsizes: it holds device names this file cannot
 * bound, and the capture prompt "press a button or move an axis". */

.bind-table {
	display: block;
	margin-bottom: 8dp;
	border-top: 1dp #1a1a1a;
}

.bind-row {
	display: flex;
	flex-direction: row;
	align-items: center;
	padding: 3dp 0;
	border-bottom: 1dp #1a1a1a;
}

.bind-slot {
	display: block;
	width: 104dp;
	flex-shrink: 0;
	font-size: 9dp;
	text-transform: uppercase;
	letter-spacing: 0.05em;
	color: #404040;
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
}

.bind-name {
	display: block;
	flex-grow: 1;
	flex-shrink: 1;
	min-width: 0;
	font-size: 9dp;
	color: #737373;
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
}

/* The row waiting for a key or a button. */
.bind-name.capturing {
	color: #bfff00;
}

.bind-button {
	display: block;
	flex-shrink: 0;
	margin-left: 8dp;
	padding: 2dp 7dp;
	background-color: transparent;
	border: 1dp #262626;
	font-size: 9dp;
	text-transform: uppercase;
	letter-spacing: 0.08em;
	color: #525252;
	white-space: nowrap;
	tab-index: auto;
	nav: auto;
}

.bind-button:hover,
.bind-button:focus {
	color: #a3a3a3;
	border-color: #404040;
}

.bind-actions {
	display: flex;
	flex-direction: row;
	flex-wrap: wrap;
	row-gap: 6dp;
	margin-bottom: 12dp;
}

/* The inline result of a capture: a reject reason, a timeout, or the name
 * that was stored. Same treatment as .override, which is the other line in
 * this menu that reports something the user has to read. */
.bind-status {
	display: block;
	font-size: 9dp;
	line-height: 1.4;
	color: #d4a000;
	background-color: #2d2000;
	border: 1dp #4d3800;
	padding: 4dp 5dp;
	margin-bottom: 6dp;
}

/* ---- footer -------------------------------------------------------------
 *
 * Buttons first at their own width, then the settings path taking whatever
 * is left, then the hotkey. Only the path shrinks: it is the one item whose
 * text this file cannot bound, so it is the one that ellipsizes. The row
 * wraps rather than squeezing the path to nothing in a window narrower than
 * the baseline. */

.footer {
	display: flex;
	flex-direction: row;
	flex-wrap: wrap;
	align-items: center;
	flex-shrink: 0;
	row-gap: 6dp;
	margin-top: 10dp;
	padding-top: 8dp;
	border-top: 1dp #262626;
}

.button {
	display: block;
	flex-shrink: 0;
	margin-right: 8dp;
	padding: 4dp 10dp;
	background-color: transparent;
	border: 1dp #262626;
	font-size: 9dp;
	text-transform: uppercase;
	letter-spacing: 0.1em;
	color: #525252;
	white-space: nowrap;
	tab-index: auto;
	nav: auto;
}

.button:hover,
.button:focus {
	color: #a3a3a3;
	border-color: #404040;
}

.footer-path {
	display: block;
	flex-grow: 1;
	flex-shrink: 1;
	min-width: 0;
	font-size: 8dp;
	color: #333333;
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
}

.footer-hotkey {
	display: block;
	flex-shrink: 0;
	margin-left: 12dp;
	font-size: 8dp;
	color: #525252;
	white-space: nowrap;
}

.key {
	color: #a3a3a3;
}

/* ---- fps readout (fps.rml) ----------------------------------------------
 *
 * Sized for the widest reading the model can format, "119.9 fields/s
 * 100.0 ms": 24 characters of 9dp mono with 0.05em of letter-spacing
 * (5.85dp each, 141dp) plus 10dp of padding and 2dp of border. The height
 * is one 9dp line at line-height 1.2 (10.8dp) plus the same. */

body.fps {
	top: 8dp;
	right: 8dp;
	width: 154dp;
	height: 18dp;
	/* Never in the way of a click aimed at the menu underneath. */
	pointer-events: none;
	background-color: #0a0a0a;
	border: 1dp #262626;
}

.fps-text {
	display: block;
	padding: 2dp 5dp;
	font-size: 9dp;
	letter-spacing: 0.05em;
	color: #a3a3a3;
	text-align: right;
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
}

/* ---- launcher (launcher.rml) ---------------------------------------------
 *
 * The launcher draws over an empty backbuffer: there is no scanout behind
 * it, so its body is opaque #0a0a0a rather than the menu's translucent
 * panel. Everything else is the same restricted set of boxes and text. */

body.launcher {
	width: 100%;
	height: 100%;
	box-sizing: border-box;
	padding: 18dp 22dp;
	display: flex;
	flex-direction: column;
	background-color: #0a0a0a;
}

.launcher-shell {
	display: block;
	flex-grow: 1;
	min-height: 0;
	overflow-x: hidden;
	overflow-y: auto;
}

.title-block {
	display: block;
	margin-bottom: 16dp;
	padding-bottom: 8dp;
	border-bottom: 1dp #262626;
}

/* Holds whichever of the two title states is up: the image built from the
 * user's disc, or the word ICO when there is none. Fixed at exactly the size
 * both of its children are given, so the box does not depend on which one is
 * in the document. */
.title-mark {
	display: block;
	width: 238dp;
	height: 56dp;
	margin: 0;
	padding: 0;
}

/*
	The two title states, and they must stay the same box: 238 by 56dp, no
	margin, no padding, no border. A swap then changes pixels and never
	layout, whether it happens before the first frame (the usual case) or
	after a disc is chosen in the window.

	238 by 56 is also the size src/runtime/ui/title_logo.cpp rasterises the
	wordmark at, scaled by the overlay's dp ratio: 238dp is the wordmark's own
	aspect (4.2522, measured) at the 56dp height the title block reserves, and
	the letters come out about as tall as the 34dp text they replace, the rest
	being the 4 percent border the geometry carries. Both numbers are mirrored
	as kRtTitleLogoDpWidth and kRtTitleLogoDpHeight in
	src/runtime/ui/title_logo.h and must agree with these, or the image is
	rasterised for one box and drawn across another, which resamples it and
	softens the edges. ui_launcher.cpp logs a line naming both if they ever
	disagree.

	No width or height is left to the texture: an img sized from its own
	intrinsic dimensions would change size with the raster.
*/
.title-logo {
	display: block;
	width: 238dp;
	height: 56dp;
	margin: 0;
	padding: 0;
}

.title-name {
	display: block;
	width: 238dp;
	height: 56dp;
	margin: 0;
	padding: 0;
	font-family: "Playfair Display";
	font-weight: 700;
	font-size: 34dp;
	letter-spacing: 0.12em;
	color: #f9fafb;
	/* Centres the one line in the 56dp box above. */
	line-height: 56dp;
	white-space: nowrap;
	overflow: hidden;
}

.title-tagline {
	display: block;
	margin-top: 4dp;
	font-size: 9dp;
	text-transform: uppercase;
	letter-spacing: 0.05em;
	color: #737373;
	line-height: 1.3;
}

.disc-panel {
	display: block;
	padding: 10dp 12dp;
	background-color: #0d0d0d;
	border: 1dp #262626;
	margin-bottom: 14dp;
}

.disc-path {
	display: block;
	font-size: 10dp;
	line-height: 1.4;
	color: #e5e5e5;
	/* A disc path has no spaces to break at; without this a long one runs
	 * off the panel. Wrapping, not clipping: which file is mounted is the
	 * one thing this window exists to show. */
	word-break: break-all;
}

.disc-source {
	display: block;
	margin-top: 3dp;
	font-size: 9dp;
	line-height: 1.4;
	color: #525252;
	word-break: break-all;
}

/* Wraps: at the baseline the two buttons fit on one line, and a narrower
 * window drops the second one below rather than pushing it off the panel. */
.disc-actions {
	display: flex;
	flex-direction: row;
	flex-wrap: wrap;
	row-gap: 6dp;
	margin-top: 8dp;
}

.path-row {
	display: flex;
	flex-direction: row;
	align-items: center;
	margin-top: 6dp;
}

.path-row input.text {
	width: auto;
	flex-grow: 1;
	flex-shrink: 1;
	min-width: 0;
	margin-right: 8dp;
}

/* What the last action did. Not a failure, so it stays in the quiet type
 * scale; .error-line below is the one that shouts. */
.status-line {
	display: block;
	margin-top: 8dp;
	font-size: 9dp;
	line-height: 1.4;
	color: #737373;
	word-break: break-word;
}

/* The boot precheck's message: the same treatment as .override and
 * .bind-status, which are the other two lines in this UI the user has to
 * read before anything works. */
.error-line {
	display: block;
	margin-top: 8dp;
	padding: 4dp 5dp;
	font-size: 9dp;
	line-height: 1.4;
	color: #d4a000;
	background-color: #2d2000;
	border: 1dp #4d3800;
	word-break: break-word;
}

.launcher-actions {
	display: flex;
	flex-direction: row;
	flex-wrap: wrap;
	row-gap: 6dp;
	margin-bottom: 12dp;
}

.start-button {
	color: #d4d4d4;
	border-color: #404040;
}

/* Start with a precheck that has not passed. Still clickable: pressing it
 * re-runs the precheck and reports what is wrong, which is more use than a
 * button that ignores the click. */
.button.disabled,
.button.disabled:hover,
.button.disabled:focus {
	color: #333333;
	border-color: #1a1a1a;
}

.startup-row {
	margin-bottom: 4dp;
}

/* The build identity, which this file cannot bound. */
.launcher-footer {
	display: block;
	flex-shrink: 0;
	margin-top: 10dp;
	padding-top: 8dp;
	border-top: 1dp #262626;
	font-size: 8dp;
	color: #333333;
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
}

/* ---- credits (credits.rml, and the menu's About pane) -------------------- */

body.credits {
	width: 100%;
	height: 100%;
	box-sizing: border-box;
	padding: 18dp 22dp;
	display: flex;
	flex-direction: column;
	background-color: #0a0a0a;
}

.credits-shell {
	display: block;
	flex-grow: 1;
	min-height: 0;
	overflow-x: hidden;
	overflow-y: auto;
}

.credits-line {
	display: block;
	font-family: "Playfair Display";
	font-size: 13dp;
	line-height: 1.3;
	color: #d4d4d4;
}

/* Clickable: ui_launcher.cpp hands it to SDL_OpenURL. Focusable too, so a
 * gamepad can reach it. */
.credits-url {
	display: block;
	margin-top: 3dp;
	font-size: 10dp;
	color: #a3a3a3;
	word-break: break-all;
	tab-index: auto;
	nav: auto;
}

.credits-url:hover,
.credits-url:focus {
	color: #bfff00;
}

.credits-heading {
	margin-top: 14dp;
}

/* One credit a line at the baseline, wrapping at a space when the line is
 * longer than the pane. break-word so that the one long token in the list,
 * a font's license file name, breaks rather than running out of the box. */
.credits-item {
	display: block;
	font-size: 9dp;
	color: #737373;
	line-height: 1.5;
	word-break: break-word;
}

.credits-actions {
	display: flex;
	flex-direction: row;
	flex-wrap: wrap;
	row-gap: 6dp;
	margin-top: 14dp;
}
