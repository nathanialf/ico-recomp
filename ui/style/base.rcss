/* ui/style/base.rcss: the shared look of the overlay documents.
 *
 * Deliberately restricted to what the overlay renderer can draw
 * (src/runtime/ui/ui_render.cpp): solid and translucent boxes, text, and
 * scissored regions. No border-radius, box-shadow, gradients, filters,
 * container opacity or clip masks: each of those reaches a RenderInterface
 * function that is not implemented in this build and logs a line saying so.
 * The two transforms in the documents are the rotated bracket label and
 * the scale a checkbox animates through as it is checked.
 *
 * Sizes are in dp, not px. The context's density-independent pixel ratio is
 * set from the surface height against the 640x480 baseline (ui.cpp), so the
 * same document reads at the same size in a small window and a large one.
 * 640x480 is the layout's design size, not the default window size: the
 * default window is 1280x960, the same layout at a dp ratio of exactly 2.
 * Every width below is derived to fit at ratio 1, so the whole layout is
 * still readable in a window dragged down to the baseline.
 *
 * RmlUi ships no default stylesheet, so every element used by a document
 * gets its display value here.
 *
 * Two families, one rule: JetBrains Mono carries everything a value is read
 * out of (labels, controls, values, hints, taglines, the footer, the fps
 * readout), Playfair Display carries names and titles (nav names, section
 * titles, the launcher title). Both are loaded in ui.cpp, which disables
 * the UI if either is missing.
 *
 * Column widths are derived from the longest string each column can hold,
 * at the mono advance of 0.6em plus that rule's letter-spacing. The three
 * that decide a width are "Right stick right" (binding slot), "Profiler
 * period, fields" (control label) and "Fullscreen (exclusive)" (select
 * value).
 *
 * Overflow: anything whose text is not bounded by this file (a settings
 * path, a disc path, a binding name, a version string) either wraps or is
 * clipped with an ellipsis. RmlUi resolves text-overflow against the
 * element holding the text, and only when that element's overflow is not
 * visible (Source/Core/ElementText.cpp ResolveTextOverflow), so the three
 * always appear together: white-space: nowrap, overflow: hidden,
 * text-overflow: ellipsis. All three are registered properties in RmlUi 6.3
 * (Source/Core/StyleSheetSpecification.cpp), and the ellipsis glyph U+2026
 * is present in both fonts.
 *
 * Palette, one place:
 *   panels    #d8c7a1  #e4d5b2  #e9dcbc  (sand, after the game)
 *   hairlines #1a1a1a black rules; #a8997a disabled; #c8b58c and #bfab82 hover fills
 *   type      #8a7d63 disabled, #4a3f2c secondary, #141414 primary,
 *             #000000 hover and focus
 *   accent    #1a1a1a (a control that is on)
 *   warning   #3d2600 on #e9cf8e, border #1a1a1a
 *   restart   #8f2418 (.note-restart, the cold keys and nothing else)
 */

/* ---- elements ----------------------------------------------------------- */

body {
	font-family: "JetBrains Mono";
	font-weight: 400;
	font-style: normal;
	font-size: 11dp;
	color: #141414;
}

div {
	display: block;
}

span {
	display: inline;
}

/* ---- menu shell --------------------------------------------------------- */

/* The body is a plain block: both of its children are positioned against
 * its edges rather than stacked in a flex column, so the shell's height is
 * definite and the footer is pinned to the window instead of following the
 * content. The insets that were this element's padding are now the shell's
 * and the footer's own. */
body.menu {
	width: 100%;
	height: 100%;
	box-sizing: border-box;
	display: block;
	/* The one translucent surface: the game's scanout stays visible behind
	 * the panel. The alpha is on the background color, not on the element;
	 * container opacity would need a render layer. */
	background-color: rgba(216, 199, 161, 235);
	/* A direction key answered by the document itself (nothing focused, or
	 * whatever was focused is gone) picks the first or last focusable
	 * element in document order: the pad's recovery and wrap mechanism,
	 * ui/ui_events.cpp. */
	nav: auto;
}

/* Anchored on all four sides, so its height is what the window leaves
 * between the top inset and the footer rather than whatever its content
 * adds up to. RmlUi resolves top and bottom together for an absolutely
 * positioned box (Source/Core/Layout/LayoutDetails.cpp, GetInsetHeight), so
 * this is a definite height and .pane can take a percentage of it. */
.shell {
	position: absolute;
	top: 12dp;
	left: 14dp;
	right: 14dp;
	bottom: 48dp;
	display: flex;
	flex-direction: row;
}

/* ---- left navigation column ---------------------------------------------
 *
 * 160dp of the 612dp the shell spans at the baseline: 140dp of buttons,
 * then the 14dp bracket and its 6dp gap. A button's text box is
 * 140dp less 9dp of padding either side and 1dp of border, so 120dp, which
 * is 24 characters of the 8dp tagline (8 * (0.6 + 0.02) = 4.96dp each).
 * The longest tagline in the document is 22. A longer one wraps to a
 * second line and the button grows, which is why nothing here is nowrap. */

/* flex-start, not the default stretch: the column is as tall as the button
 * stack, so the bracket beside it ends level with the last button rather
 * than running to the bottom of the shell. */
.nav {
	display: flex;
	flex-direction: row;
	align-self: flex-start;
	width: 160dp;
	flex-shrink: 0;
}

.nav-stack {
	display: block;
	flex-grow: 1;
	min-width: 0;
}

.nav-button {
	display: flex;
	flex-direction: column;
	width: 100%;
	box-sizing: border-box;
	padding: 7dp 9dp;
	margin-bottom: 5dp;
	background-color: transparent;
	border: 1dp #1a1a1a;
	tab-index: auto;
	nav: auto;
}

.nav-button:hover {
	background-color: #c8b58c;
	border-color: #1a1a1a;
}

/* The tab whose pane is showing. */
.nav-button.active {
	background-color: #bfab82;
	border-color: #1a1a1a;
}

.nav-name {
	display: block;
	font-family: "Playfair Display";
	font-weight: 700;
	font-size: 12dp;
	letter-spacing: 0.05em;
	color: #141414;
	line-height: 1.2;
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
}

.nav-tagline {
	display: block;
	font-size: 8dp;
	letter-spacing: 0.02em;
	color: #4a3f2c;
	line-height: 1.3;
	margin-top: 2dp;
}

.nav-button:hover .nav-name,
.nav-button.active .nav-name {
	color: #000000;
}

.nav-button:hover .nav-tagline,
.nav-button.active .nav-tagline {
	color: #3d3526;
}

/* The pad's cursor, and the keyboard's: inverted whether or not the tab
 * is the active one, so the selection reads at a glance. Placed after
 * .active and :hover so it wins the ties at equal specificity. */
.nav-button:focus {
	background-color: #1a1a1a;
	border-color: #1a1a1a;
}

.nav-button:focus .nav-name {
	color: #d8c7a1;
}

.nav-button:focus .nav-tagline {
	color: #c8b58c;
}

/* The bracket beside the nav stack: a 1dp vertical line with 1dp caps
 * reaching back toward the buttons, and a label rotated onto the line.
 * Built from nested divs because RCSS has no ::before/::after. The 5dp of
 * margin-bottom cancels the last nav button's own margin, so the bracket
 * ends on that button's bottom edge.
 *
 * Nothing in here is interactive, and pointer-events is inherited, so one
 * declaration takes the whole bracket out of hit testing. It has to: the
 * label below is a 70dp box centred on the 1dp line, which reaches 35dp
 * back over the nav buttons 6dp to its left. Only its text is painted, but
 * the box is still hit tested, and being later in document order it would
 * take hover and clicks off the right edge of every card. */
.bracket {
	display: flex;
	flex-direction: column;
	width: 14dp;
	flex-shrink: 0;
	margin-left: 6dp;
	margin-bottom: 5dp;
	pointer-events: none;
}

/* 6dp starting 5dp to the left of the line, so the cap spans -5dp to +1dp
 * and covers the line's own 1dp column. A 5dp cap ends where the line
 * begins, which at a dp ratio of 1 leaves the two sharing no pixel and the
 * corner open. */
.bracket-cap {
	display: block;
	width: 6dp;
	height: 1dp;
	margin-left: -5dp;
	background-color: #1a1a1a;
}

/* A column: a line segment, the label, a line segment. The label used to
 * sit on one continuous line and hide it with an opaque box in the panel
 * colour; over the translucent menu panel that box no longer matches what
 * is behind it, so the line is drawn in two pieces that stop at the label's
 * box instead, and the label carries no background at all. */
.bracket-line {
	display: flex;
	flex-direction: column;
	align-items: flex-start;
	width: 1dp;
	flex-grow: 1;
	background-color: transparent;
}

.bracket-seg {
	display: block;
	width: 1dp;
	flex-grow: 1;
	background-color: #1a1a1a;
}

/* Rotated about its own center, so the pre-rotation box is centered on the
 * line with a negative margin of half its width. 48dp holds "Menu" at
 * 8dp mono with 0.08em of letter-spacing (8 * 0.68 = 5.44dp each, 22dp in
 * all) with the same 13dp of clear line at either end that the wider box
 * gave the old eight-letter label. flex-shrink: 0 because the label is a
 * flex item of the 1dp-wide line: at the default shrink factor RmlUi
 * squeezes the box down before the -24dp margin applies, and the rotated
 * box lands left of the line instead of on it. Nowrap because a wrap here
 * would rotate a second line into the nav column.
 *
 * The box is 48dp square so the two line segments above and below it stop
 * 13dp short of the 22dp text at either end: before rotation the segments
 * meet the box's top and bottom edges, and the rotation is about the box's
 * centre, so after it the same 48dp reach lies along the line. The -24dp
 * margin puts the box's centre on the line's left edge. */
.bracket-label {
	display: block;
	width: 48dp;
	height: 48dp;
	flex-shrink: 0;
	margin-left: -24dp;
	padding: 0;
	background-color: transparent;
	text-align: center;
	text-transform: uppercase;
	letter-spacing: 0.08em;
	font-size: 8dp;
	/* One 8dp line centred in the 48dp box, so the rotation about the
	 * box's centre lands the text on the line. */
	line-height: 48dp;
	color: #4a3f2c;
	white-space: nowrap;
	transform: rotate(-90deg);
}

/* ---- content pane -------------------------------------------------------
 *
 * Scrolls vertically and clips horizontally: every row inside it either
 * wraps or ellipsizes, so nothing needs horizontal room, and clipping is
 * the backstop rather than the mechanism. An open dropdown is not clipped
 * by this: RmlUi gives the select box clip: none (WidgetDropDown.cpp), so
 * it escapes the pane's clip region. At the baseline the pane's content is
 * 434dp wide, less the 6dp scrollbar.
 *
 * The pane is as tall as the shell, and the shell has a definite height
 * because it is anchored top and bottom. That is what makes a tab taller
 * than the shell overflow as far as RmlUi is concerned, build a scrollbar
 * and give the wheel a scrollable container (Element.cpp,
 * GetClosestScrollableContainer): before the shell was anchored, its own
 * height followed its content and nothing overflowed. The height: 100%
 * below restates what the shell's default align-items: stretch already
 * gives a flex item; it is kept so the pane's height does not depend on
 * the shell's alignment. The measured figures come out on the "menu
 * heights:" log line ui.cpp writes when the menu opens. */

.pane {
	display: block;
	flex-grow: 1;
	min-width: 0;
	height: 100%;
	overflow-x: hidden;
	overflow-y: auto;
	padding-left: 14dp;
	padding-right: 4dp;
}

/* 6dp: at 5dp the bar is there but neither visible at a glance nor easy to
 * grab. Black on the sand track so it reads as a control. */
scrollbarvertical {
	width: 6dp;
}

scrollbarvertical slidertrack {
	background-color: #c8b58c;
}

scrollbarvertical sliderbar {
	width: 6dp;
	min-height: 24dp;
	background-color: #1a1a1a;
}

scrollbarvertical sliderbar:hover {
	background-color: #000000;
}

.section {
	display: block;
	margin-bottom: 14dp;
}

.section-header {
	display: flex;
	flex-direction: row;
	align-items: baseline;
	border-bottom: 1dp #1a1a1a;
	padding-bottom: 3dp;
	margin-bottom: 8dp;
}

.section-number {
	display: block;
	font-size: 8dp;
	color: #4a3f2c;
	flex-shrink: 0;
	margin-right: 8dp;
}

.section-title {
	display: block;
	font-family: "Playfair Display";
	font-size: 12dp;
	font-weight: 700;
	text-transform: uppercase;
	letter-spacing: 0.06em;
	color: #141414;
	min-width: 0;
	overflow: hidden;
	text-overflow: ellipsis;
}

.note {
	display: block;
	font-size: 9dp;
	color: #4a3f2c;
	line-height: 1.5;
}

/* ---- controls -----------------------------------------------------------
 *
 * A label is 9dp mono with 0.05em of letter-spacing, so 5.85dp a character:
 * "Profiler period, fields", the longest at 23 characters, is 134.6dp of
 * the 428dp the pane leaves. Labels therefore never need to wrap, and are
 * not told to. */

.control {
	display: block;
	margin-bottom: 10dp;
}

.control-label {
	display: block;
	font-size: 9dp;
	text-transform: uppercase;
	letter-spacing: 0.05em;
	color: #4a3f2c;
	margin-bottom: 3dp;
}

.hint {
	display: block;
	font-size: 9dp;
	color: #4a3f2c;
	line-height: 1.4;
	margin-top: 3dp;
}

/* The note under a cold key (docs/SETTINGS.md section 2): changing it
 * restarts the program, or, once the game is running, cannot be done here
 * at all. A hint's colour would read as one more description of the
 * control; this one is about what the change does to the run, so it is the
 * one red in the menu. #8f2418 is that red against all three sand panels
 * and is used nowhere else. */
.note-restart {
	display: block;
	font-size: 9dp;
	color: #8f2418;
	line-height: 1.4;
	margin-top: 3dp;
}

/* An environment variable owns this key for the life of the run. */
.override {
	display: block;
	font-size: 9dp;
	line-height: 1.4;
	color: #3d2600;
	background-color: #e9cf8e;
	border: 1dp #1a1a1a;
	padding: 4dp 5dp;
	margin-top: 4dp;
}

input,
select {
	tab-index: auto;
	nav: auto;
}

/* Every text field and select gets a width in dp rather than a percentage
 * of the pane: stretched to the pane a select puts its arrow at the far
 * right of a very wide bar, which reads as a table row rather than as a
 * control. 220dp is the width of the longest option string it has to hold,
 * "Fullscreen (exclusive)": 22 characters of 10dp mono (6dp each, 132dp)
 * plus 14dp of border and padding on both sides and the 24dp kept clear on
 * the right for the arrow, so 170dp, with room left for a longer one.
 * "3840 x 2880 (6x)", the widest window size, is 96dp of text. The label
 * stays on its own line above.
 *
 * The vertical padding is 3dp and not 4dp: 20dp of border box less 2dp of
 * border leaves 18dp, and one 10dp line at the inherited line-height of
 * 1.2 is 12dp, so 3dp above and below centres that line on the control.
 * With 4dp the content box was 10dp, two short of the line it holds, and
 * the text sat 1dp low in a text field and 5dp low in a select (see the
 * selectvalue rule below). */
input.text,
select {
	display: block;
	box-sizing: border-box;
	width: 220dp;
	max-width: 100%;
	height: 20dp;
	padding: 3dp 6dp;
	font-size: 10dp;
	background-color: #e9dcbc;
	border: 1dp #1a1a1a;
	color: #141414;
	text-align: left;
}

input.text:focus,
select:focus {
	background-color: #1a1a1a;
	border-color: #1a1a1a;
	color: #d8c7a1;
}

select:focus selectvalue {
	color: #d8c7a1;
}

select:focus selectarrow {
	border-top-color: #d8c7a1;
}

input.text:disabled,
select:disabled,
input.checkbox:disabled,
input.range:disabled {
	color: #4a3f2c;
	border-color: #a8997a;
}

/* WidgetDropDown builds the select's three children and places two of them
 * itself, both against the select's content box and not its border box:
 * the value element is offset to the content origin (WidgetDropDown.cpp
 * OnRender, SetOffset right after FormatElement) and the arrow is anchored
 * TOP_RIGHT within the content box (ElementUtilities::PositionElement).
 * The select's own padding therefore already moved both of them; whatever
 * they set for themselves is measured from a 206x12dp content area at
 * (7,4) inside the 220x20dp border box. Repeating the select's 20dp height
 * and 4dp 6dp padding here is what pushed the value text to a centre of
 * 15dp in a control whose centre is 10dp, and hung the last 5dp of the box
 * below the bottom border.
 *
 * The widget sets overflow: hidden on this element itself, which is what
 * lets text-overflow resolve here. */
select selectvalue {
	width: auto;
	/* FormatElement is handed the select's border box, so width: auto
	 * resolves against 220dp: 24dp of margin leaves 196dp, ending the text
	 * at x=203dp where the arrow begins rather than under it. */
	margin-right: 24dp;
	/* Exactly the 12dp line box, with no padding of its own: the select's
	 * padding has already placed this box at (7,4), so the line runs from
	 * 4dp to 16dp and its centre is the control's centre. */
	height: 12dp;
	padding: 0dp;
	color: #141414;
	white-space: nowrap;
	text-overflow: ellipsis;
}

/* A downward triangle drawn out of borders on a zero-sized box. The
 * overlay renderer has no file images, no gradients and no shaders
 * (docs/SETTINGS.md, supported RCSS subset), so an image or gradient
 * decorator would draw nothing at all; borders are plain triangles and are
 * drawn. RmlUi mitres border corners, and with a 0x0 padding box the two
 * inner corners of the top edge collapse onto the same point
 * (GeometryBackgroundBorder::ComputeBorderMetrics), which leaves the top
 * border as a 10dp wide, 6dp tall triangle pointing down. The side borders
 * are transparent, so they are skipped rather than blended.
 *
 * The arrow is anchored to the top right of the content box, so its right
 * edge lands at 213dp, the same 7dp in from the border box as the text is
 * on the left. margin-top centres it: 4dp of content origin plus 3dp puts
 * the 6dp triangle at 7dp to 13dp, centred on the control's 10dp. */
select selectarrow {
	width: 0dp;
	height: 0dp;
	margin-top: 3dp;
	border-top: 6dp #000000;
	border-left: 5dp transparent;
	border-right: 5dp transparent;
}

select:hover selectarrow {
	border-top-color: #141414;
}

select:disabled selectarrow {
	border-top-color: #000000;
}

/* box-sizing keeps the open list exactly as wide as the control: the
 * widget formats this element against the select's border box and offsets
 * it to the border box origin, so a content-box 100% would be 222dp under
 * a 220dp control. */
select selectbox {
	margin-left: 0;
	box-sizing: border-box;
	width: 100%;
	max-height: 120dp;
	background-color: #e9dcbc;
	border: 1dp #1a1a1a;
}

/* display: block is also what the widget sets on each option as it adopts
 * it; stating it here means an option laid out before that still reads as
 * a row rather than as inline text. 3dp above and below the 12dp line box
 * makes an 18dp row with the text centred in it, and the 6dp inset behind
 * the list's own 1dp border puts a row's text at the same 7dp from the
 * left edge as the closed value above it. */
select selectbox option {
	display: block;
	width: auto;
	padding: 3dp 6dp;
	font-size: 10dp;
	color: #000000;
	background-color: #e9dcbc;
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
}

select selectbox option:checked {
	color: #141414;
}

/* :padhl is not an RmlUi pseudo-class: it is set by hand, one option at a
 * time, by ui/ui_events.cpp's select pad session (see its file comment) to
 * mark the option a held-and-not-yet-committed Up/Down has moved to. Same
 * colours as :hover, which is the mouse's equivalent state. */
select selectbox option:hover,
select selectbox option:padhl {
	background-color: #c8b58c;
	color: #141414;
}

.check-row {
	display: flex;
	flex-direction: row;
	align-items: center;
	/* The row is the control: it takes the focus and the click and toggles
	 * the bound value itself (data-event-click in the documents), so one
	 * focus style reaches the box, the mark and the label. The input inside
	 * only shows the state. Padding with a matching negative margin gives
	 * the inverted fill some air without moving the row. */
	padding: 2dp 4dp;
	margin: -2dp -4dp;
	tab-index: auto;
	nav: auto;
}

.check-row:focus {
	background-color: #1a1a1a;
}

.check-row:focus .check-label {
	color: #d8c7a1;
}

.check-row:focus input.checkbox {
	background-color: #1a1a1a;
	border-color: #d8c7a1;
}

.check-row:focus .check-arm {
	background-color: #d8c7a1;
}

/* The box is a wrapper so a glyph can sit on top of the native input: the
 * input takes the click and the focus, the glyph only shows the state.
 * On is a black X in the box, off is the empty box; both keep the sand
 * field and the black border, so the state reads from the mark and not
 * from a shade of fill (user request, 2026-09-03). */
.check-box {
	position: relative;
	display: block;
	width: 11dp;
	height: 11dp;
	flex-shrink: 0;
	margin-right: 7dp;
}

input.checkbox {
	display: block;
	/* Border box, so the 1dp border is inside the 11dp and the box's centre
	 * is the 5.5dp the mark's bars are centred on; content-box would make
	 * it 13dp and put the mark 1dp up and left of centre. */
	box-sizing: border-box;
	width: 11dp;
	height: 11dp;
	margin: 0;
	tab-index: none;
	pointer-events: none;
	background-color: #e9dcbc;
	border: 1dp #1a1a1a;
	transition: border-color 0.15s cubic-in-out;
}

/* No :hover, :focus or :checked rule on the input itself. With tab-index
 * none and pointer-events none it can never be hovered or focused, and the
 * two states that do reach it come from the row: .check-row:focus for the
 * ring, and the checked mark from the sibling rule on .check-glyph below.
 * The transition above is for that focus border. */

/* Over the input, never in its way: pointer-events none hands the click
 * through to the box underneath. The X is two black bars, each the length
 * of the inner square's diagonal, centred in the box and rotated 45
 * degrees either way about their own centres (RmlUi's default
 * transform-origin is the box centre), so the mark is symmetric and runs
 * corner to corner.
 *
 * The pop the old :checked fill had is on the sibling rule below, not here.
 * RmlUi restarts an animation only when the `animation` property itself
 * changes (Element.cpp, dirty_animation); the documents show and hide this
 * element with data-if, which only sets and clears `display`
 * (DataViewDefault.cpp, DataViewIf::Update), so an animation declared here
 * would run once at document load, while the glyph is hidden, and never
 * again. Declaring it on a rule that starts applying when the box is
 * checked is what starts it: SetPseudoClass dirties the element and its
 * siblings for exactly this reason (Element.cpp, "in case of RCSS presence
 * of sibling combinators"). */
.check-glyph {
	position: absolute;
	top: 0;
	left: 0;
	width: 11dp;
	height: 11dp;
	pointer-events: none;
}

input.checkbox:checked + .check-glyph {
	animation: 0.18s cubic-out check-pop;
}

/* 13dp long and 3dp thick: at 45 degrees a 13dp bar spans 9.2dp each way,
 * the inner square of an 11dp box with 1dp borders. Every offset is a
 * whole pixel at dp ratio 1 and 2, so the bar's centre lands on the box's
 * centre (5.5dp) without rounding: left (11 - 13) / 2 = -1dp, top
 * (11 - 3) / 2 = 4dp. */
.check-arm {
	position: absolute;
	left: -1dp;
	top: 4dp;
	width: 13dp;
	height: 3dp;
	background-color: #000000;
	transform: rotate(45deg);
}

.check-arm-b {
	transform: rotate(-45deg);
}

@keyframes check-pop {
	from { transform: scale(0.7); }
	60% { transform: scale(1.15); }
	to { transform: scale(1.0); }
}

/* Wraps rather than ellipsizes: the checkbox beside it is the control, and
 * a clipped label would hide which setting it is. */
.check-label {
	display: block;
	min-width: 0;
	font-size: 10dp;
	line-height: 1.3;
	color: #141414;
}

/* The same 220dp box as a select, so the controls line up down the pane:
 * the slider takes what the reading beside it leaves. */
.range-row {
	display: flex;
	flex-direction: row;
	align-items: center;
	width: 220dp;
	max-width: 100%;
}

input.range {
	display: block;
	flex-grow: 1;
	min-width: 0;
	height: 14dp;
}

input.range slidertrack {
	height: 4dp;
	margin-top: 5dp;
	background-color: #1a1a1a;
}

input.range sliderbar {
	width: 14dp;
	height: 14dp;
	background-color: #1a1a1a;
	/* Transparent at rest so the focus ring below only changes colour, never
	 * the box size WidgetSlider laid the track out against. */
	border: 1dp transparent;
}

input.range sliderbar:hover,
input.range sliderbar:active {
	background-color: #000000;
}

/* WidgetSlider sets this pseudo-class on the bar itself when the range gets
 * focus (WidgetSlider.cpp, EventId::Focus/Blur), so a real :focus selector
 * on the bar works even though the range as a whole is what tab-index
 * lands on. */
input.range sliderbar:focus {
	background-color: #000000;
	border-color: #d8c7a1;
}

input.range:focus slidertrack {
	background-color: #4a3f2c;
}

/* Widest reading is "100" for the volume and "0.95" for a deadzone: four
 * characters of 10dp mono, 24dp. */
.range-value {
	display: block;
	width: 36dp;
	flex-shrink: 0;
	margin-left: 8dp;
	text-align: right;
	font-size: 10dp;
	color: #000000;
	white-space: nowrap;
	overflow: hidden;
}

/* ---- binding tables ------------------------------------------------------
 *
 * One row per RtKeyBind / RtPadBind slot, rendered by a data-for loop in
 * menu.rml. Same construction as the controls above: hairline separators and
 * flat boxes only, nothing that reaches an unimplemented RenderInterface
 * call.
 *
 * The row is three columns: a fixed slot name, the binding, and the button.
 * The slot column is 104dp, which is "Right stick right" at 9dp mono with
 * 0.05em of letter-spacing (17 characters at 5.85dp). The button is sized
 * by its own text and never shrinks. The binding takes what is left, 264dp
 * at the baseline, and ellipsizes: it holds device names this file cannot
 * bound, and the capture prompt "press a button or move an axis". */

.bind-table {
	display: block;
	margin-bottom: 8dp;
	border-top: 1dp #a8997a;
}

.bind-row {
	display: flex;
	flex-direction: row;
	align-items: center;
	padding: 3dp 0;
	border-bottom: 1dp #a8997a;
}

.bind-slot {
	display: block;
	width: 104dp;
	flex-shrink: 0;
	font-size: 9dp;
	text-transform: uppercase;
	letter-spacing: 0.05em;
	color: #4a3f2c;
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
}

.bind-name {
	display: block;
	flex-grow: 1;
	flex-shrink: 1;
	min-width: 0;
	font-size: 9dp;
	color: #4a3f2c;
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
}

/* The row waiting for a key or a button. */
.bind-name.capturing {
	color: #1a1a1a;
}

.bind-button {
	display: block;
	flex-shrink: 0;
	margin-left: 8dp;
	padding: 2dp 7dp;
	background-color: transparent;
	border: 1dp #1a1a1a;
	font-size: 9dp;
	text-transform: uppercase;
	letter-spacing: 0.08em;
	color: #4a3f2c;
	white-space: nowrap;
	tab-index: auto;
	nav: auto;
}

.bind-button:hover {
	color: #000000;
	border-color: #000000;
}

.bind-button:focus {
	background-color: #1a1a1a;
	border-color: #1a1a1a;
	color: #d8c7a1;
}

.bind-actions {
	display: flex;
	flex-direction: row;
	flex-wrap: wrap;
	row-gap: 6dp;
	margin-bottom: 12dp;
}

/* The inline result of a capture: a reject reason, a timeout, or the name
 * that was stored. Same treatment as .override, which is the other line in
 * this menu that reports something the user has to read. */
.bind-status {
	display: block;
	font-size: 9dp;
	line-height: 1.4;
	color: #3d2600;
	background-color: #e9cf8e;
	border: 1dp #1a1a1a;
	padding: 4dp 5dp;
	margin-bottom: 6dp;
}

/* ---- footer -------------------------------------------------------------
 *
 * Buttons first at their own width, then the settings path taking whatever
 * is left, then the hotkey. Only the path shrinks: it is the one item whose
 * text this file cannot bound, so it is the one that ellipsizes. nowrap
 * because the row is pinned to the window's bottom edge: a second line
 * would grow the box downward and off the window, so a narrow window
 * squeezes the path to its ellipsis instead of wrapping the hotkey below.
 *
 * Pinned rather than stacked under the shell, so it sits in the same place
 * whatever the open tab holds. The box is 30dp tall: one button row (9dp
 * text at line-height 1.2, 4dp of padding either side and a 1dp border, so
 * 21dp) under 8dp of padding and the 1dp rule. 12dp up from the bottom,
 * its top edge is 42dp from it, which the shell's 48dp bottom inset clears
 * by 6dp. */

.footer {
	position: absolute;
	left: 14dp;
	right: 14dp;
	bottom: 12dp;
	display: flex;
	flex-direction: row;
	flex-wrap: nowrap;
	align-items: center;
	padding-top: 8dp;
	border-top: 1dp #1a1a1a;
}

.button {
	display: block;
	flex-shrink: 0;
	margin-right: 8dp;
	padding: 4dp 10dp;
	background-color: transparent;
	border: 1dp #1a1a1a;
	font-size: 9dp;
	text-transform: uppercase;
	letter-spacing: 0.1em;
	color: #4a3f2c;
	white-space: nowrap;
	tab-index: auto;
	nav: auto;
}

.button:hover {
	color: #000000;
	border-color: #000000;
}

.button:focus {
	background-color: #1a1a1a;
	border-color: #1a1a1a;
	color: #d8c7a1;
}

.footer-path {
	display: block;
	flex-grow: 1;
	flex-shrink: 1;
	min-width: 0;
	font-size: 8dp;
	color: #8a7d63;
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
}

/* .footer-hint is what the last device used can do here: the pad line while
 * a controller was the last thing touched, the keyboard line otherwise,
 * filled by the model each field from rt_input_last_device(). It sits on
 * the same line as the hotkey and reads the same way, so it shares the
 * rule. */
.footer-hotkey,
.footer-hint {
	display: block;
	flex-shrink: 0;
	margin-left: 12dp;
	font-size: 8dp;
	color: #4a3f2c;
	white-space: nowrap;
}

.footer-hint {
	letter-spacing: 0.05em;
}

.key {
	color: #000000;
}

/* ---- fps readout (fps.rml) ----------------------------------------------
 *
 * Sized for the widest reading the model can format, "119.9 fields/s
 * 100.0 ms": 24 characters of 9dp mono with 0.05em of letter-spacing
 * (5.85dp each, 141dp) plus 10dp of padding and 2dp of border. The height
 * is one 9dp line at line-height 1.2 (10.8dp) plus the same. */

body.fps {
	top: 8dp;
	right: 8dp;
	width: 154dp;
	height: 18dp;
	/* Never in the way of a click aimed at the menu underneath. */
	pointer-events: none;
	background-color: #0a0a0a;
	border: 1dp #262626;
}

.fps-text {
	display: block;
	padding: 2dp 5dp;
	font-size: 9dp;
	letter-spacing: 0.05em;
	color: #a3a3a3;
	text-align: right;
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
}

/* ---- launcher (launcher.rml) ---------------------------------------------
 *
 * The launcher draws over an empty backbuffer: there is no scanout behind
 * it, so its body is opaque sand (#d8c7a1) rather than the menu's
 * translucent panel. Everything else is the same restricted set of boxes and text.
 *
 * Same construction as the menu: the shell and the footer are anchored to
 * the body's edges rather than stacked in a flex column, so the shell's
 * height is definite and the footer stays on the window's bottom edge
 * however long the disc path, the status line and the precheck message
 * grow. The 18dp and 22dp insets were this body's padding. */

body.launcher {
	width: 100%;
	height: 100%;
	box-sizing: border-box;
	display: block;
	background-color: #d8c7a1;
	/* Same reason as body.menu above. */
	nav: auto;
}

/* bottom: 44dp clears the footer, whose top edge is 36.6dp up (see
 * .launcher-footer), by 7.4dp. */
.launcher-shell {
	position: absolute;
	top: 18dp;
	left: 22dp;
	right: 22dp;
	bottom: 44dp;
	overflow-x: hidden;
	overflow-y: auto;
}

.title-block {
	display: block;
	margin-bottom: 16dp;
	padding-bottom: 8dp;
	border-bottom: 1dp #1a1a1a;
}

/* Holds whichever of the two title states is up: the image built from the
 * user's disc, or the word ICO when there is none. Fixed at exactly the size
 * both of its children are given, so the box does not depend on which one is
 * in the document. */
.title-mark {
	display: block;
	width: 238dp;
	height: 56dp;
	margin: 0;
	padding: 0;
}

/*
	The two title states, and they must stay the same box: 238 by 56dp, no
	margin, no padding, no border. A swap then changes pixels and never
	layout, whether it happens before the first frame (the usual case) or
	after a disc is chosen in the window.

	238 by 56 is also the size src/runtime/ui/title_logo.cpp rasterises the
	wordmark at, scaled by the overlay's dp ratio: 238dp is the wordmark's own
	aspect (4.2522, measured) at the 56dp height the title block reserves, and
	the letters come out about as tall as the 34dp text they replace, the rest
	being the 4 percent border the geometry carries. Both numbers are mirrored
	as kRtTitleLogoDpWidth and kRtTitleLogoDpHeight in
	src/runtime/ui/title_logo.h and must agree with these, or the image is
	rasterised for one box and drawn across another, which resamples it and
	softens the edges. ui_launcher.cpp logs a line naming both if they ever
	disagree.

	No width or height is left to the texture: an img sized from its own
	intrinsic dimensions would change size with the raster.
*/
.title-logo {
	display: block;
	width: 238dp;
	height: 56dp;
	margin: 0;
	padding: 0;
}

.title-name {
	display: block;
	width: 238dp;
	height: 56dp;
	margin: 0;
	padding: 0;
	font-family: "Playfair Display";
	font-weight: 700;
	font-size: 34dp;
	letter-spacing: 0.12em;
	color: #141414;
	/* Centres the one line in the 56dp box above. */
	line-height: 56dp;
	white-space: nowrap;
	overflow: hidden;
}

.disc-panel {
	display: block;
	padding: 10dp 12dp;
	background-color: #e4d5b2;
	border: 1dp #1a1a1a;
	margin-bottom: 14dp;
}

.disc-path {
	display: block;
	font-size: 10dp;
	line-height: 1.4;
	color: #141414;
	/* A disc path has no spaces to break at; without this a long one runs
	 * off the panel. Wrapping, not clipping: which file is mounted is the
	 * one thing this window exists to show. */
	word-break: break-all;
}

.disc-source {
	display: block;
	margin-top: 3dp;
	font-size: 9dp;
	line-height: 1.4;
	color: #4a3f2c;
	word-break: break-all;
}

/* Wraps: at the baseline the two buttons fit on one line, and a narrower
 * window drops the second one below rather than pushing it off the panel. */
.disc-actions {
	display: flex;
	flex-direction: row;
	flex-wrap: wrap;
	row-gap: 6dp;
	margin-top: 8dp;
}

.path-row {
	display: flex;
	flex-direction: row;
	align-items: center;
	margin-top: 6dp;
}

.path-row input.text {
	width: auto;
	flex-grow: 1;
	flex-shrink: 1;
	min-width: 0;
	margin-right: 8dp;
}

/* What the last action did. Not a failure, so it stays in the quiet type
 * scale; .error-line below is the one that shouts. */
.status-line {
	display: block;
	margin-top: 8dp;
	font-size: 9dp;
	line-height: 1.4;
	color: #4a3f2c;
	word-break: break-word;
}

/* The boot precheck's message: the same treatment as .override and
 * .bind-status, which are the other two lines in this UI the user has to
 * read before anything works. */
.error-line {
	display: block;
	margin-top: 8dp;
	padding: 4dp 5dp;
	font-size: 9dp;
	line-height: 1.4;
	color: #3d2600;
	background-color: #e9cf8e;
	border: 1dp #1a1a1a;
	word-break: break-word;
}

.launcher-actions {
	display: flex;
	flex-direction: row;
	flex-wrap: wrap;
	row-gap: 6dp;
	margin-bottom: 12dp;
}

.start-button {
	color: #141414;
	border-color: #000000;
}

/* Start with a precheck that has not passed. Still clickable: pressing it
 * re-runs the precheck and reports what is wrong, which is more use than a
 * button that ignores the click. */
.button.disabled,
.button.disabled:hover,
.button.disabled:focus {
	color: #8a7d63;
	border-color: #a8997a;
}

.startup-row {
	margin-bottom: 4dp;
}

/* The build identity on the left, the author credit on the right. Only the
 * version line shrinks: it is the one item whose text this file cannot
 * bound, so it is the one that ellipsizes. Pinned 18dp up from the bottom
 * edge; the box is 18.6dp tall (one 8dp line at line-height 1.2, which is
 * taller than the 8dp mark beside it, under 8dp of padding and the 1dp
 * rule), so its top edge is 36.6dp up. */
.launcher-footer {
	position: absolute;
	left: 22dp;
	right: 22dp;
	bottom: 18dp;
	display: flex;
	flex-direction: row;
	align-items: center;
	padding-top: 8dp;
	border-top: 1dp #1a1a1a;
}

.footer-version {
	display: block;
	flex-grow: 1;
	flex-shrink: 1;
	min-width: 0;
	font-size: 8dp;
	color: #8a7d63;
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
}

/* Clickable: ui_launcher.cpp hands it to SDL_OpenURL. Focusable too, so a
 * gamepad can reach it. */
.credit {
	display: flex;
	flex-direction: row;
	align-items: center;
	flex-shrink: 0;
	margin-left: 12dp;
	tab-index: auto;
	nav: auto;
	/* Transparent at rest so the focus ring below only changes colour, never
	 * the box size. */
	border: 1dp transparent;
}

.credit:focus {
	background-color: #1a1a1a;
	border-color: #1a1a1a;
}

/* The defnf mark drawn as boxes rather than loaded as an image: the overlay
 * renderer's LoadTexture is a stub (ui_render.cpp). Four rows of six 2dp
 * cells, 12dp by 8dp in all; the grid itself is in the comment above the
 * footer in launcher.rml, decoded there from the one path in
 * public/images/defnf-logo.svg in ../React-Portfolio. White at 0.7, which
 * is what the sidebar there draws it at (invert(1) then opacity 0.7), and
 * 0.9 on hover. The alpha is on the cell colour because container opacity
 * would need a render layer this build does not have. */
.defnf-logo {
	display: block;
	flex-shrink: 0;
	margin-right: 5dp;
}

.logo-row {
	display: flex;
	flex-direction: row;
}

.logo-cell {
	display: block;
	width: 2dp;
	height: 2dp;
	background-color: transparent;
}

.logo-cell.on {
	background-color: rgba(0, 0, 0, 179);
}

/* #4a3f2c, the secondary type colour, one step above the version stamp
 * beside it. */
.credit-name {
	display: block;
	font-size: 8dp;
	letter-spacing: 0.05em;
	color: #4a3f2c;
	white-space: nowrap;
}

.credit:hover .credit-name {
	color: #000000;
}

.credit:focus .credit-name {
	color: #d8c7a1;
}

.credit:hover .logo-cell.on {
	background-color: rgba(0, 0, 0, 230);
}

.credit:focus .logo-cell.on {
	background-color: rgba(216, 199, 161, 230);
}

/* ---- launcher palette ------------------------------------------------------
 *
 * The overlay is sand with black type and rules after the game's own
 * palette (user request, 2026-09-03); the shared token table in the header
 * carries the values. The wordmark is rasterised white by title_logo.cpp;
 * image-color multiplies it per vertex in the overlay shader, so the same
 * raster draws black here and stays white for the cursor cut from it. */

body.launcher .title-logo {
	image-color: #000000;
}

body.launcher .title-name {
	color: #000000;
}


/* ---- the drawn cursor (cursor.rml) ---------------------------------------
 *
 * Shown whenever the pointer owns the mouse on one of the game's own menus.
 * Relative mouse mode is on then, so the OS cursor is hidden and this is the
 * only cursor on screen: it has to read over whatever the game is drawing
 * behind it, which is why both forms of it are a light shape with a dark
 * outline rather than a single flat one.
 *
 * The first form is the letter I of the game's own wordmark, cut out of the
 * title image and turned to a cursor by src/runtime/ui/cursor_image.cpp. It
 * carries its own outline in its pixels and gets its box and its offset from
 * the model, in dp, so there is nothing to style here beyond placing it. The
 * arrow below it is what is drawn when no such image could be built.
 *
 * Both triangles are drawn the way the select arrow above is, out of one
 * border on a zero-sized box: with a 0x0 padding box the two inner corners
 * of the bottom edge collapse onto the padding box origin, which is the
 * element's own top left, so a bottom border of height H with a transparent
 * right border of width W is the triangle (0,H) (W,H) (0,0). The sharp
 * corner is at the top left, so left/top place the tip.
 *
 * The outline is the outer triangle showing past the inner one. The inner
 * offsets and sizes are the outer triangle inset by 2dp on all three edges
 * and rounded to whole dp: tip at (2, 7), 15dp tall, 9dp wide. Rounding
 * leaves the visible outline between about 1.6dp and 2.4dp wide, and the
 * 9:15 slope within a quarter of a dp of the outer's 14:24 over the whole
 * of its height.
 *
 * 24dp tall is about 24 px at the 640x480 design density, which is what the
 * dp ratio is 1 at (src/runtime/ui/ui.cpp).
 */

body.cursor-body {
	width: 100%;
	height: 100%;
	display: block;
	pointer-events: none;
}

/* The presented scanout rectangle, placed by the model in percent of the
 * surface. Absolute, so the cursor inside it resolves its own percentages
 * against the picture and not against the window. */
.cursor-area {
	position: absolute;
	display: block;
}

/* The cursor position itself: a zero-sized box the model places in percent
 * of the rectangle above. Its padding box is that single point, so both
 * cursors below position themselves in offsets from the point the hit test
 * uses. */
.cursor-point {
	position: absolute;
	display: block;
	width: 0dp;
	height: 0dp;
}

/* The image cursor. Everything about its box comes from the model: the size
 * it was cut at, in dp, and a left/top of minus its hotspot, which is what
 * puts the glyph's point on the cursor point. */
.menu-cursor-image {
	position: absolute;
	display: block;
}

/* The fallback arrow's outline, at the cursor point. */
.menu-cursor {
	position: absolute;
	display: block;
	left: 0dp;
	top: 0dp;
	width: 0dp;
	height: 0dp;
	border-bottom: 24dp #0a0a0a;
	border-right: 14dp transparent;
}

/* The fill, over it. Its containing block is the outline's padding box,
 * which is the zero-sized point at the outline's own top left, so these are
 * offsets from the tip. */
.menu-cursor-fill {
	position: absolute;
	display: block;
	left: 2dp;
	top: 7dp;
	width: 0dp;
	height: 0dp;
	border-bottom: 15dp #f5f5f5;
	border-right: 9dp transparent;
}
