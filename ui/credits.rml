<rml>
<head>
	<title>Credits</title>
	<link type="text/rcss" href="style/base.rcss"/>
</head>
<!--
	The credits, shown over the launcher. No data model: there is nothing
	here to bind. The two clickable elements (the site link and Back) get
	plain click listeners attached by id in src/runtime/ui/ui_launcher.cpp.
	The same text is inline in the menu's About pane, which is reachable
	while the game runs.
-->
<body class="credits">
	<div class="credits-shell">
		<div class="section-header">
			<span class="section-number">00</span>
			<span class="section-title">Credits</span>
		</div>

		<div class="credits-line">Developed by Nathanial Fine</div>
		<div class="credits-url" id="credits-url">https://defnf.com</div>

		<div class="control-label credits-heading">Built with</div>
		<div class="credits-item">paraLLEl-GS, Arntzen Software, LGPLv3+, loaded as a separate shared library</div>
		<div class="credits-item">SDL3, zlib license</div>
		<div class="credits-item">RmlUi, MIT</div>
		<div class="credits-item">FreeType, FreeType License</div>
		<div class="credits-item">Playfair Display, SIL Open Font License; the notice ships in ui/fonts/PlayfairDisplay-OFL.txt</div>
		<div class="credits-item">JetBrains Mono, SIL Open Font License; the notice ships in ui/fonts/JetBrainsMono-OFL.txt</div>

		<div class="credits-actions">
			<div class="button" id="credits-back">Back</div>
		</div>
	</div>
</body>
</rml>
