# selftest droppings: the log and settings selftests default their scratch
# directory to a relative path, so a run from the repo root leaves one here.
# CI passes ICORECOMP_LOG_SELFTEST_DIR / ICORECOMP_SETTINGS_SELFTEST_DIR
# instead and writes nothing into the checkout.
/log-selftest-scratch/
/settings-selftest-scratch/

# editor/tool droppings
.cache/
compile_commands.json
