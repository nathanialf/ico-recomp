<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Generated by CMake at install time (see the macOS app bundle section of
     CMakeLists.txt). CFBundleExecutable names the file in Contents/MacOS
     that Finder launches, CFBundleIconFile the icon in Contents/Resources
     with its extension left off, which is how Apple's loader reads it.

     CFBundleExecutable is the runtime binary in a build that bundles no
     MoltenVK, and the ico-launch shell script in one that does. That script
     sets DYLD_LIBRARY_PATH and the two Vulkan driver variables from its own
     location and execs the binary; packaging/macos-launch.sh.in says why
     that cannot be done from here instead. LSEnvironment is deliberately
     absent: its values are literal strings with no expansion of the
     bundle's own path, so it cannot name a file inside a bundle the user is
     free to move, and a wrong path there would be read as a working setting.

     LSMinimumSystemVersion is 14.0 because that is the oldest macOS this
     port targets; the build is Apple Silicon only, which is why there is no
     LSRequiresNativeExecution or fat-binary handling here. -->
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleExecutable</key>
    <string>@ICORECOMP_BUNDLE_EXECUTABLE@</string>
    <key>CFBundleIconFile</key>
    <string>@ICORECOMP_BUNDLE_ICON_NAME@</string>
    <key>CFBundleIdentifier</key>
    <string>@ICORECOMP_BUNDLE_IDENTIFIER@</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>ICO Recomp</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>0.1</string>
    <key>CFBundleVersion</key>
    <string>0.1</string>
    <key>LSMinimumSystemVersion</key>
    <string>14.0</string>
    <key>NSHighResolutionCapable</key>
    <true/>
</dict>
</plist>
